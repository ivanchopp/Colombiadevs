# Copia los NOMBRES a las variables de Railway (Service > Variables). No pongas valores aquí.

# Clave de la API de Claude. Sin ella la app corre en modo demo (lecturas guardadas).
ANTHROPIC_API_KEY=

# Modelo para leer facturas (opcional). Por defecto: claude-sonnet-5-5
MODELO_ENTRADA=

# Fuerza el modo demo aunque haya clave (opcional): demo
ENTRADA_MODO=

# Fija «hoy» para el calendario y las reglas (opcional, recomendado para la demo): 2026-10-17
FECHA_DEMO=

# Ruta de la base del acta (opcional). En Railway se usa solo el volumen: RAILWAY_VOLUME_MOUNT_PATH
ACTA_DB=
