# Copia los NOMBRES a las variables de Railway (Service > Variables). No pongas valores aquí.

# --- IA para leer facturas (elige UN proveedor; sin clave la app corre en modo demo) ---
# Proveedor: gemini o claude. Si lo dejas vacío: Claude si hay ANTHROPIC_API_KEY, si no Gemini.
PROVEEDOR_IA=

# Gemini (ahora)
GEMINI_API_KEY=
MODELO_GEMINI=          # opcional. Por defecto: gemini-3.5-flash. El anterior, gemini-2.5-flash, ya fue retirado

# Claude (después)
ANTHROPIC_API_KEY=
MODELO_ENTRADA=         # opcional. Por defecto: claude-sonnet-5-5

# Fuerza el modo demo aunque haya claves (opcional): demo
ENTRADA_MODO=

# --- Demo ---
# Facturas que cada sala puede subir (entero de 1 a 100; por defecto 5). Cada una gasta una llamada de IA.
FACTURAS_MAX=

# Fija «hoy» para el calendario y las reglas (recomendado): 2026-10-17
FECHA_DEMO=

# Ruta de la base del acta (opcional). En Railway se usa solo el volumen: RAILWAY_VOLUME_MOUNT_PATH
ACTA_DB=
